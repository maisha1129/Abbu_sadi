    "gitUpdate": {
        "autoUpdate": true,
        "url": "",
        "branch": "",
        "checkIntervalMinutes": 60,
        "cmdUpdate": true,
        "protect": [],
        "_notes": "Disabled by default. To enable: set autoUpdate:true and url to YOUR OWN GitHub repo (e.g. https://github.com/you/your-bot). Migrated from Rx-mirai-goat - staged/admin-confirmed updates only, never applies silently. Use the 'update' command to check/apply manually at any time regardless of autoUpdate."
    },
    "_notes_login": "Login is appstate.json (cookie) only. The old EMAIL/PASSWORD fallback and includes/fca/botacc.js (an unauditable obfuscated third-party module) have been removed for security reasons. autoRefreshFbstate: if true, rewrites appstate.json with the freshest cookies right after each successful login (migrated from Rx-mirai-goat).",
    "e2ee": {
        "enable": false,
        "saveType": "path",
        "devicePath": "./e2ee_device.json",
        "deviceData": null,
        "_notes": "End-to-end encryption (E2EE / Labyrinth) for Messenger, migrated from Rx-mirai-goat. saveType MUST be 'path' (not 'memory') for E2EE GROUP chats to keep working - 'memory' registers a brand-new device every restart, and Facebook does not treat a new device as an existing member of an already-encrypted group thread, so the bot silently stops receiving/sending in E2EE groups after any restart. 'path' persists the same device identity in devicePath across restarts (recommended). deviceData: leave null unless manually restoring exported device keys. | DISABLED: the native messagix.so bridge (koffi FFI) causes process-level crashes on MQTT reconnect that no error handler can catch. Re-enable only if you specifically need E2EE group messaging and have a stable server environment."
    },
    "twoIdMode": {
        "enable": false,
        "autoSwitchOnError": false,
        "_notes": "Two-account mode, used by the 'accountswitch' command. Primary account = appstate.json. For a secondary account, place its cookie/appstate file at account.txt2 in the bot root (no email/password auto-login)."
    },
